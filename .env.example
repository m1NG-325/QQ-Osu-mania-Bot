# demo: simulated data, no account required. live: official osu! API.
BOT_MODE=demo
HOST=127.0.0.1
PORT=3210

# Optional local artwork you have permission to use.
# Leave empty to use the original SVG background; restart after changing.
PANEL_BACKGROUND_PATH=

# Only needed for BOT_MODE=live. Fill locally; do not share the secret.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Optional QQ integration, off by default.
QQ_ENABLED=false
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
# NapCat HTTP client token (HMAC-SHA1 X-Signature verification).
ONEBOT_EVENT_TOKEN=
# Comma-separated group IDs. Empty means no groups are allowed.
QQ_ALLOWED_GROUPS=
# Optional per-group prefix overrides; other groups keep ! and ！.
QQ_GROUP_PREFIXES={}

# dan sticker generation: Python 3 + Pillow; service starts automatically.
# Set the Python executable path here, or leave empty to use python on PATH.
DAN_PYTHON=
